#!/bin/bash

# Post-merge hook: atualiza automaticamente o banco de dados após git pull
# Isto garante que quando os colegas fazem pull, recebem todos os dados novos

# Caminho para o artisan (o hook está em scripts/, o projeto está 1 nível acima)
PROJECT_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
ARTISAN="$PROJECT_ROOT/artisan"

# Verificar se o artisan existe
if [ ! -f "$ARTISAN" ]; then
    echo "Erro: artisan não encontrado em $ARTISAN"
    exit 1
fi

# Mudar para o diretório do projeto
if ! cd "$PROJECT_ROOT"; then
    echo "Erro: não foi possível aceder a $PROJECT_ROOT"
    exit 1
fi

SNAPSHOT="database/seeders/ExportedDataSeeder.php"
if [ ! -f "$SNAPSHOT" ]; then
    echo "Snapshot de dados não encontrado; não há dados exportados para restaurar."
    exit 0
fi

RESTORE_SNAPSHOT=false
if ! git rev-parse --verify ORIG_HEAD >/dev/null 2>&1; then
    # Sem a referência anterior, restaurar o snapshot é a opção segura.
    RESTORE_SNAPSHOT=true
else
    git diff --quiet ORIG_HEAD HEAD -- "$SNAPSHOT"
    DIFF_STATUS=$?

    if [ "$DIFF_STATUS" -eq 1 ]; then
        RESTORE_SNAPSHOT=true
    elif [ "$DIFF_STATUS" -ne 0 ]; then
        echo "Erro: não foi possível verificar se o snapshot mudou."
        exit 1
    fi
fi

if [ "$RESTORE_SNAPSHOT" = true ]; then
    echo "O snapshot de dados mudou. A recriar a base de dados a partir do snapshot..."
    if ! php "$ARTISAN" migrate:fresh --seed --no-interaction; then
        echo "Erro ao restaurar o snapshot. A base de dados não foi atualizada."
        echo "Depois de corrigir o problema, executa: php artisan migrate:fresh --seed"
        exit 1
    fi
else
    echo "O snapshot de dados não mudou. A aplicar apenas migrations novas..."
    if ! php "$ARTISAN" migrate --no-interaction; then
        echo "Erro ao aplicar as migrations da base de dados."
        exit 1
    fi
fi

php "$ARTISAN" storage:link 2>/dev/null
echo "Base de dados atualizada com sucesso."

exit 0
