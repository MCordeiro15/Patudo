#!/bin/bash

# Pre-push hook: exporta automaticamente todos os dados antes de fazer push
# Isto garante que quando alguém faz push, todos os dados (users, petsitters, fotos, etc.)
# são incluídos no commit para que os colegas recebam tudo com git pull

# Caminho para o artisan (o hook está em scripts/, o projeto está 1 nível acima)
PROJECT_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
ARTISAN="$PROJECT_ROOT/artisan"

# Verificar se o artisan existe
if [ ! -f "$ARTISAN" ]; then
    echo "Erro: artisan não encontrado em $ARTISAN"
    exit 1
fi

# Mudar para o diretório do projeto
cd "$PROJECT_ROOT"

# Exportar todos os dados
echo "Exportando dados do banco de dados..."
if ! php "$ARTISAN" db:export; then
    echo "Erro ao exportar dados. Push cancelado."
    exit 1
fi

# Adicionar o seeder exportado
if ! git add -- database/seeders/ExportedDataSeeder.php; then
    echo "Erro ao adicionar os dados exportados. Push cancelado."
    exit 1
fi

# Verificar se há mudanças para commitar
if git diff --cached --quiet -- database/seeders/ExportedDataSeeder.php; then
    echo "Nenhuma mudança nos dados. Continuando com o push."
else
    # Commitar as mudanças
    if ! git commit -m "Auto-export: atualizar dados do banco de dados" --trailer "Co-authored-by: Junie <junie@jetbrains.com>" -- database/seeders/ExportedDataSeeder.php; then
        echo "Erro ao commitar os dados. Push cancelado."
        exit 1
    fi

    echo "Os dados foram exportados num novo commit. O push atual foi cancelado porque o Git já tinha preparado o commit antigo para envio."
    echo "Repete o mesmo comando git push para enviar também o commit com os dados."
    exit 1
fi

# Continuar com o push
exit 0
